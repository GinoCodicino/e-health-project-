  m_Script: {fileID: 11500000, guid: c11da82bd497544b39908620c118cafc, type: 3}
  m_Name: EthanBrooks_Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: 
    text: Hey! You're heading up the mountain?
  - speaker: 
    text: Take it slow and drink some water on the way. The weather changes fast
      up there.
  - speaker: 
    text: Come back and tell me how it went!
