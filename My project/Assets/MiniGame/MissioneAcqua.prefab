--- !u!114 &1927172167290270597
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5934410054169265145}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2681c4df90d8e5242981308b851d38c4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QTEAcqua
  goccieMax: 12
  scivolateMax: 3
  fangoMax: 3
  acquaPerGoccia: 16
  acquaPerFango: 8
  acquaPersaScivolata: 20
  tempoPassoIniziale: 1.4
  tempoPassoFinale: 0.9
  velocitaIniziale: 0.9
  velocitaFinale: 1.8
  zonaPulitaIniziale: 0.18
  zonaPulitaFinale: 0.1
  margineFango: 0.12
  tempoMaxGoccia: 5
  ricordoNonno: "Dal taccuino del nonno:\n\xABMi fermai alla baita di una giovane
    del posto. Mi offr\xEC un pranzo abbondante, ma rifiutai: mi bast\xF2 l'acqua
    del torrente, freschissima e abbondante, bevuta a grandi sorsi.\xBB"
  presente: "Oggi il torrente \xE8 un rigagnolo fangoso. Riempi il secchio goccia
    dopo goccia, senza scivolare."
  istruzioni: "[A] o [D] = passo sulla roccia (premi il tasto indicato in tempo)\n[SPAZIO]
    = raccogli la goccia quando l'indicatore \xE8 nel verde\nAttenzione al fango!"
  player: {fileID: 0}
  onVittoria:
    m_PersistentCalls:
      m_Calls: []
  onSconfitta:
    m_PersistentCalls:
      m_Calls: []
